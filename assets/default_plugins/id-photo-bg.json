{
  "id": "id-photo-bg",
  "name": "证件照换底",
  "version": "1.2.0",
  "minAppVersion": "1.0.0",
  "category": "image",
  "description": "借鉴 HivisionIDPhotos 证件照换底算法，采用多点色彩采样 + 连续 Alpha 掩码 + 边缘去溢色技术消除杂色色边。一键更换一寸、二寸常用考试报名与工作照底色为标准白底、红底、蓝底、职业灰底或任意自定义底色。",
  "icon": "badge",
  "author": "Toolbox Team",
  "engineType": "native_image",
  "inputs": [
    {
      "id": "sourceFiles",
      "label": "选择证件照原图",
      "type": "file_picker",
      "required": true,
      "allowMultiple": false,
      "allowedExtensions": [
        "jpg",
        "jpeg",
        "png",
        "webp"
      ]
    },
    {
      "id": "bgColor",
      "label": "目标底色 (点击调色盘或选择色块)",
      "type": "color_picker",
      "defaultValue": "#FFFFFF"
    },
    {
      "id": "standardSize",
      "label": "证件照冲印规格",
      "type": "select",
      "defaultValue": "keep",
      "options": [
        {
          "label": "保持原图尺寸 (仅换底色)",
          "value": "keep"
        },
        {
          "label": "一寸 (295 x 413 px, 比例居中裁剪)",
          "value": "1_inch"
        },
        {
          "label": "小二寸 (413 x 531 px, 护照/签证)",
          "value": "small_2_inch"
        },
        {
          "label": "二寸 (413 x 626 px, 毕业照/标准二寸)",
          "value": "2_inch"
        }
      ]
    },
    {
      "id": "feather",
      "label": "边缘羽化与去溢色半径 (默认 3)",
      "type": "slider",
      "defaultValue": 3,
      "min": 1,
      "max": 8,
      "step": 1
    },
    {
      "id": "tolerance",
      "label": "背景色彩容差 (背景光照不匀时调大，默认 50)",
      "type": "slider",
      "defaultValue": 50,
      "min": 25,
      "max": 85,
      "step": 5
    }
  ],
  "outputs": [
    {
      "id": "compare",
      "label": "换底前后画质细节对比",
      "type": "image_compare",
      "description": "滑动滑块可即时对比换底前后的发丝细节与去溢色效果"
    },
    {
      "id": "summary",
      "label": "证件照处理结果摘要",
      "type": "copyable_text"
    }
  ],
  "action": {
    "handler": "id_photo_bg",
    "params": {
      "color": "${bgColor}",
      "size": "${standardSize}",
      "feather": "${feather}",
      "tolerance": "${tolerance}"
    }
  }
}
