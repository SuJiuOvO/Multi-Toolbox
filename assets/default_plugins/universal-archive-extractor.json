{
  "id": "universal-archive-extractor",
  "name": "万能压缩与解压工坊",
  "version": "1.0.0",
  "minAppVersion": "1.0.0",
  "category": "other",
  "platforms": [
    "universal"
  ],
  "executionType": "native_tool",
  "description": "【全平台万能解压与归档母舰】无需安装外部解压缩软件，原生集成 7z (支持 LZMA/LZMA2/Deflate/AES-256 加密)、RAR4/RAR5、Zip、Tar、GZ、BZ2、XZ、APK、EPUB 等主流格式的极速解压与目录树还原；同时支持将选定文件或目录一键打包为 Zip 或 Tar.gz 归档。",
  "icon": "folder_zip",
  "author": "Toolbox 架构实验室",
  "engineType": "native_tool",
  "inputs": [
    {
      "id": "archiveMode",
      "label": "操作模式",
      "type": "select",
      "defaultValue": "extract",
      "options": [
        {
          "label": "📦 万能解压 (支持 7z / RAR / Zip / Tar / GZ / XZ / APK)",
          "value": "extract"
        },
        {
          "label": "🗜️ 压缩归档 (打包为 Zip 或 Tar.gz 文件)",
          "value": "compress"
        }
      ]
    },
    {
      "id": "archiveInput",
      "label": "选择待解压的文件",
      "type": "file_picker",
      "required": true,
      "allowMultiple": false,
      "allowedExtensions": [
        "7z",
        "rar",
        "zip",
        "tar",
        "gz",
        "tgz",
        "bz2",
        "tbz",
        "xz",
        "txz",
        "cb7",
        "cbr",
        "apk",
        "jar",
        "epub"
      ],
      "visibleIf": {
        "field": "archiveMode",
        "equals": "extract"
      }
    },
    {
      "id": "archivePassword",
      "label": "解压密码 (若压缩包设置了密码保护请输入，无密码留空)",
      "type": "text",
      "defaultValue": "",
      "required": false,
      "visibleIf": {
        "field": "archiveMode",
        "equals": "extract"
      }
    },
    {
      "id": "filesToCompress",
      "label": "选择待打包压缩的文件 (支持多选)",
      "type": "file_picker",
      "required": true,
      "allowMultiple": true,
      "visibleIf": {
        "field": "archiveMode",
        "equals": "compress"
      }
    },
    {
      "id": "compressFormat",
      "label": "目标压缩格式",
      "type": "select",
      "defaultValue": "zip",
      "options": [
        {
          "label": "📦 Zip 格式 (全平台通用标准，兼容所有系统与设备)",
          "value": "zip"
        },
        {
          "label": "🐧 Tar.Gz 格式 (高压缩率流式打包，Linux / 开发运维常用)",
          "value": "tar.gz"
        }
      ],
      "visibleIf": {
        "field": "archiveMode",
        "equals": "compress"
      }
    },
    {
      "id": "outputArchiveName",
      "label": "输出归档包文件名 (可选，默认 archive.zip)",
      "type": "text",
      "defaultValue": "archive.zip",
      "required": false,
      "visibleIf": {
        "field": "archiveMode",
        "equals": "compress"
      }
    }
  ],
  "action": {
    "handler": "archive_universal",
    "params": {
      "archiveMode": "${archiveMode}",
      "archivePassword": "${archivePassword}",
      "compressFormat": "${compressFormat}",
      "outputArchiveName": "${outputArchiveName}"
    }
  }
}
