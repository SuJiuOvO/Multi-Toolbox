{
  "id": "universal-archive-extractor",
  "name": "压缩与解压",
  "version": "1.0.0",
  "minAppVersion": "1.0.0",
  "category": "other",
  "platforms": [
    "universal"
  ],
  "executionType": "native_tool",
  "description": "【全平台万能解压与分卷归档】原生支持 7z、RAR4/RAR5、Zip、Tar.Gz、BZ2、XZ 及 .001 / .part1.rar / .z01 分卷压缩包的极速解压，解压后自动归整至压缩包同名文件夹；同时支持单卷与多分卷打包压缩。",
  "icon": "folder_zip",
  "author": "Toolbox 架构实验室",
  "engineType": "native_tool",
  "inputs": [
    {
      "id": "archiveMode",
      "label": "操作模式",
      "type": "select",
      "defaultValue": "extract",
      "options": [
        {
          "label": "📦 万能解压 (支持单卷与 .001 / .part1.rar / .z01 分卷，自动解压至同名文件夹)",
          "value": "extract"
        },
        {
          "label": "🗜️ 压缩归档 (支持单文件打包与自定义分卷压缩)",
          "value": "compress"
        }
      ]
    },
    {
      "id": "archiveInput",
      "label": "选择待解压的压缩包或分卷文件 (支持多选分卷 .001/.002 等)",
      "type": "file_picker",
      "required": true,
      "allowMultiple": true,
      "allowedExtensions": [
        "7z",
        "rar",
        "zip",
        "tar",
        "gz",
        "tgz",
        "bz2",
        "tbz",
        "xz",
        "txz",
        "cb7",
        "cbr",
        "apk",
        "jar",
        "epub",
        "001",
        "z01",
        "r00"
      ],
      "visibleIf": {
        "field": "archiveMode",
        "equals": "extract"
      },
      "isArchive": true,
      "allowFolder": false,
      "pickButtonText": "选择压缩包 / 分卷文件 (支持多选分卷 .001/.002 等)",
      "selectionSummary": "已选定 {count} 个分卷/归档文件"
    },
    {
      "id": "archivePassword",
      "label": "解压密码 (若压缩包设置了密码保护请输入，无密码留空)",
      "type": "text",
      "defaultValue": "",
      "required": false,
      "visibleIf": {
        "field": "archiveMode",
        "equals": "extract"
      }
    },
    {
      "id": "filesToCompress",
      "label": "选择待打包压缩的文件或文件夹 (支持多选文件与选取文件夹)",
      "type": "file_picker",
      "required": true,
      "allowMultiple": true,
      "visibleIf": {
        "field": "archiveMode",
        "equals": "compress"
      },
      "preserveDirectoryEntries": true,
      "selectionSummary": "已收纳 {count} 项待压缩条目 (包含文件与文件夹)"
    },
    {
      "id": "compressFormat",
      "label": "目标压缩格式",
      "type": "select",
      "defaultValue": "zip",
      "options": [
        {
          "label": "📦 Zip 格式 (全平台通用标准，兼容所有系统与设备)",
          "value": "zip"
        },
        {
          "label": "🐧 Tar.Gz 格式 (高压缩率流式打包，Linux / 开发运维常用)",
          "value": "tar.gz"
        }
      ],
      "visibleIf": {
        "field": "archiveMode",
        "equals": "compress"
      }
    },
    {
      "id": "outputArchiveName",
      "label": "输出归档包文件名 (可选，默认 archive.zip)",
      "type": "text",
      "defaultValue": "archive.zip",
      "required": false,
      "visibleIf": {
        "field": "archiveMode",
        "equals": "compress"
      }
    },
    {
      "id": "splitSizeMb",
      "label": "分卷拆分大小 (大文件自动切分为 .001, .002 ...)",
      "type": "select",
      "defaultValue": "0",
      "options": [
        {
          "label": "📦 不分卷 (生成单个完整压缩包)",
          "value": "0"
        },
        {
          "label": "✂️ 10 MB / 卷 (适合邮件附件或小文件传输)",
          "value": "10"
        },
        {
          "label": "✂️ 50 MB / 卷 (适合社交软件分片发送)",
          "value": "50"
        },
        {
          "label": "✂️ 100 MB / 卷 (通用中等分卷规格)",
          "value": "100"
        },
        {
          "label": "✂️ 500 MB / 卷 (大体积备份分卷)",
          "value": "500"
        }
      ],
      "visibleIf": {
        "field": "archiveMode",
        "equals": "compress"
      }
    }
  ],
  "action": {
    "handler": "archive_universal",
    "params": {
      "archiveMode": "${archiveMode}",
      "archivePassword": "${archivePassword}",
      "compressFormat": "${compressFormat}",
      "outputArchiveName": "${outputArchiveName}",
      "splitSizeMb": "${splitSizeMb}"
    }
  },
  "permissions": [
    "storage_manage"
  ]
}