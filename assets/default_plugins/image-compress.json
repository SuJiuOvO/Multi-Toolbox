{
  "id": "image-compress",
  "name": "图片批量压缩",
  "version": "1.1.0",
  "minAppVersion": "1.0.0",
  "category": "image",
  "description": "借鉴 Caesium 与 TinyPNG 算法体系，支持 WebP 高压、JPG 质量优化与 PNG 调色板量化。支持批量导入图片、滑动调节压缩质量、智能限制超大分辨率最长边，显著降低图片文件体积同时保持高保真画质。",
  "icon": "compress",
  "author": "Toolbox Team",
  "engineType": "native_image",
  "inputs": [
    {
      "id": "sourceFiles",
      "label": "选择待压缩图片 (支持批量)",
      "type": "file_picker",
      "required": true,
      "allowMultiple": true,
      "allowedExtensions": [
        "jpg",
        "jpeg",
        "png",
        "webp",
        "bmp"
      ]
    },
    {
      "id": "quality",
      "label": "压缩质量 (10-100)",
      "type": "slider",
      "defaultValue": 75,
      "min": 10,
      "max": 100,
      "step": 5
    },
    {
      "id": "format",
      "label": "目标导出格式",
      "type": "select",
      "defaultValue": "keep_original",
      "options": [
        {
          "label": "保持原图格式 (PNG自动启用量化减小体积)",
          "value": "keep_original"
        },
        {
          "label": "转换为 WebP (极力推荐，体积最小)",
          "value": "webp"
        },
        {
          "label": "转换为 JPEG",
          "value": "jpg"
        },
        {
          "label": "转换为 PNG (无损/调色板)",
          "value": "png"
        }
      ]
    },
    {
      "id": "maxEdge",
      "label": "超大分辨率等比限制 (防爆内存)",
      "type": "select",
      "defaultValue": "0",
      "options": [
        {
          "label": "保持原图分辨率不变",
          "value": "0"
        },
        {
          "label": "最长边限制为 2560 px (适合 2K/4K 减重)",
          "value": "2560"
        },
        {
          "label": "最长边限制为 1920 px (适合网络传输/网页)",
          "value": "1920"
        },
        {
          "label": "最长边限制为 1280 px (适合移动端/极速分享)",
          "value": "1280"
        }
      ]
    }
  ],
  "action": {
    "handler": "image_compress",
    "params": {
      "quality": "${quality}",
      "format": "${format}",
      "maxEdge": "${maxEdge}"
    }
  }
}
