{
  "id": "doc-converter",
  "name": "文档格式互转",
  "version": "2.3.0",
  "minAppVersion": "1.0.0",
  "category": "document",
  "platforms": [
    "universal"
  ],
  "description": "支持图片转PPT、PPT转长图/图片、CAD(DXF)矢量转PDF、PPT转PDF、PDF转PPT、Excel转PDF、Markdown转PDF、TXT转Word、Word转PDF、PDF转可编辑Word等各大格式互转。Windows端调用Office/WPS原生引擎实现100%保真导出与Word反向重构；Android端支持调用手机WPS/Office跳转导出并提供详细步骤指引，同时保留离线轻量引擎。",
  "icon": "doc_converter",
  "author": "Toolbox Team",
  "engineType": "native_tool",
  "inputs": [
    {
      "id": "subTool",
      "label": "转换功能模式",
      "type": "select",
      "defaultValue": "images_to_pptx",
      "options": [
        {
          "label": "🖼️ 图片批量转 PPT (全平台通用)",
          "value": "images_to_pptx",
          "platforms": [
            "universal"
          ]
        },
        {
          "label": "📷 PPT 转图片 / 拼长图 (Windows 原生 Office · 100%保真)",
          "value": "pptx_to_images",
          "platforms": [
            "windows"
          ]
        },
        {
          "label": "📷 PPT 转图片 / 长图 (调起手机 WPS / Office 导出 · 官方保真)",
          "value": "pptx_to_images_android_office",
          "platforms": [
            "android"
          ]
        },
        {
          "label": "📐 CAD(DXF) 矢量转 PDF (全平台通用)",
          "value": "cad_to_pdf",
          "platforms": [
            "universal"
          ]
        },
        {
          "label": "📽️ PDF 转 PPT 演示文稿 (全平台通用)",
          "value": "pdf_to_pptx",
          "platforms": [
            "universal"
          ]
        },
        {
          "label": "📝 Markdown 文档转 PDF (全平台通用)",
          "value": "markdown_to_pdf",
          "platforms": [
            "universal"
          ]
        },
        {
          "label": "📄 TXT 纯文本转 Word (全平台通用)",
          "value": "txt_to_docx",
          "platforms": [
            "universal"
          ]
        },
        {
          "label": "✏️ PDF 转可编辑 Word (需 Windows 安装 Office/WPS · 完整格式重构)",
          "value": "pdf_to_docx",
          "platforms": [
            "windows"
          ]
        },
        {
          "label": "✏️ PDF 转 Word (调起手机 WPS / Office 导出 · 官方高保真)",
          "value": "pdf_to_docx_android_office",
          "platforms": [
            "android"
          ]
        },
        {
          "label": "✏️ PDF 转 Word (本地离线排版引擎 · 智能清洗段落与排版)",
          "value": "pdf_to_docx_android_light",
          "platforms": [
            "android"
          ]
        },
        {
          "label": "📑 PPT 转 PDF (需 Windows 安装 Office/WPS · 100%保真)",
          "value": "pptx_to_pdf",
          "platforms": [
            "windows"
          ]
        },
        {
          "label": "📘 Word 转 PDF (需 Windows 安装 Office/WPS · 100%保真)",
          "value": "docx_to_pdf",
          "platforms": [
            "windows"
          ]
        },
        {
          "label": "📊 Excel 转 PDF (需 Windows 安装 Office/WPS · 100%保真)",
          "value": "excel_to_pdf",
          "platforms": [
            "windows"
          ]
        },
        {
          "label": "📑 PPT 转 PDF (调起手机 WPS / Office 导出)",
          "value": "pptx_to_pdf_android",
          "platforms": [
            "android"
          ]
        },
        {
          "label": "📘 Word 转 PDF (调起手机 WPS / Office 导出)",
          "value": "docx_to_pdf_android",
          "platforms": [
            "android"
          ]
        },
        {
          "label": "📊 Excel 转 PDF (调起手机 WPS / Office 导出 · 官方保真)",
          "value": "excel_to_pdf_android_office",
          "platforms": [
            "android"
          ]
        },
        {
          "label": "📊 Excel 转 PDF (本地离线轻量引擎 · 纯表格转换)",
          "value": "excel_to_pdf_android_light",
          "platforms": [
            "android"
          ]
        }
      ]
    },
    {
      "id": "imagesInput",
      "label": "选择待转换图片 (支持多选，按次序排版为幻灯片)",
      "type": "file_picker",
      "required": true,
      "allowMultiple": true,
      "allowedExtensions": [
        "jpg",
        "jpeg",
        "png",
        "webp",
        "bmp"
      ],
      "visibleIf": {
        "field": "subTool",
        "equals": "images_to_pptx"
      }
    },
    {
      "id": "aspect",
      "label": "幻灯片画面比例与方向",
      "type": "select",
      "defaultValue": "auto",
      "options": [
        {
          "label": "自适应匹配 (推荐)",
          "value": "auto"
        },
        {
          "label": "16:9 宽屏 (横向)",
          "value": "16:9"
        },
        {
          "label": "4:3 标屏 (横向)",
          "value": "4:3"
        },
        {
          "label": "3:4 竖屏 (手机/A4)",
          "value": "portrait"
        }
      ],
      "visibleIf": {
        "field": "subTool",
        "equals": "images_to_pptx"
      }
    },
    {
      "id": "pptxToImagesInput",
      "label": "选择待提取 PPT 演示文稿 (.pptx)",
      "type": "file_picker",
      "required": true,
      "allowMultiple": false,
      "allowedExtensions": [
        "pptx"
      ],
      "visibleIf": {
        "field": "subTool",
        "in": [
          "pptx_to_images",
          "pptx_to_images_android_office"
        ]
      }
    },
    {
      "id": "exportMode",
      "label": "图片输出模式",
      "type": "select",
      "defaultValue": "pages",
      "options": [
        {
          "label": "📄 逐页切图 (单张高清图片)",
          "value": "pages"
        },
        {
          "label": "📜 竖向无缝拼长图 (全部幻灯片拼接为单张超清长图)",
          "value": "long_image"
        }
      ],
      "visibleIf": {
        "field": "subTool",
        "in": [
          "pptx_to_images"
        ]
      }
    },
    {
      "id": "pptResolution",
      "label": "画面输出分辨率与清晰度",
      "type": "select",
      "defaultValue": "1080p",
      "options": [
        {
          "label": "1080P 全高清 (1920 × 1080 · 推荐)",
          "value": "1080p"
        },
        {
          "label": "2K 超清 (2560 × 1440 · 细腻呈现)",
          "value": "2k"
        },
        {
          "label": "4K 极清 (3840 × 2160 · 商业级高精度)",
          "value": "4k"
        },
        {
          "label": "720P 标清 (1280 × 720 · 紧凑省空间)",
          "value": "720p"
        }
      ],
      "visibleIf": {
        "field": "subTool",
        "in": [
          "pptx_to_images"
        ]
      }
    },
    {
      "id": "imgFormat",
      "label": "导出图片格式",
      "type": "select",
      "defaultValue": "png",
      "options": [
        {
          "label": "PNG 高清无损图片 (推荐)",
          "value": "png"
        },
        {
          "label": "JPG 紧凑图片 (体积更小)",
          "value": "jpg"
        }
      ],
      "visibleIf": {
        "field": "subTool",
        "in": [
          "pptx_to_images"
        ]
      }
    },
    {
      "id": "bundleZip",
      "label": "多张图片时自动打包为 ZIP 压缩包",
      "type": "switch",
      "defaultValue": true,
      "visibleIf": {
        "field": "subTool",
        "in": [
          "pptx_to_images"
        ]
      }
    },
    {
      "id": "cadInput",
      "label": "选择 CAD 图纸文件 (.dxf 全矢量)",
      "type": "file_picker",
      "required": true,
      "allowMultiple": false,
      "allowedExtensions": [
        "dxf"
      ],
      "visibleIf": {
        "field": "subTool",
        "equals": "cad_to_pdf"
      },
      "banners": [
        {
          "type": "warning",
          "icon": "info_outline",
          "message": "💡 格式说明：DWG / DWF 为 Autodesk 专有二进制加密格式，无法直接无损解码。请在 AutoCAD / 中望CAD / 浩辰CAD 中使用快捷命令【DXFOUT】或【另存为 -> AutoCAD DXF (*.dxf)】，本工具支持 DXF 100% 全矢量无损转换！"
        }
      ],
      "rejectedExtensions": [
        {
          "extensions": [
            ".dwg",
            ".dwf"
          ],
          "title": "CAD 专有格式转换提示",
          "message": "您选择的文件属于 DWG / DWF 专有二进制加密格式。\n\n由于该格式闭源专有，移动端与跨平台端无法直接进行高保真矢量解码。\n\n【100% 全矢量无损转换操作指引】：\n1. 在 AutoCAD、中望CAD 或浩辰CAD 中打开此图纸；\n2. 命令行键入快捷命令 DXFOUT 并按回车（或点击【另存为】选择 AutoCAD DXF 格式）；\n3. 将保存后的 .dxf 文件直接拖入本工具转换，即可立即输出高质量全矢量 PDF！"
        }
      ]
    },
    {
      "id": "cadPageSize",
      "label": "图纸 PDF 纸张规格",
      "type": "select",
      "defaultValue": "A4",
      "options": [
        {
          "label": "标准 A4 (210 × 297 mm)",
          "value": "A4"
        },
        {
          "label": "中型 A3 (297 × 420 mm 工程图)",
          "value": "A3"
        },
        {
          "label": "大型 A2 (420 × 594 mm 建筑施工图)",
          "value": "A2"
        }
      ],
      "visibleIf": {
        "field": "subTool",
        "equals": "cad_to_pdf"
      }
    },
    {
      "id": "cadOrientation",
      "label": "页面方向",
      "type": "select",
      "defaultValue": "auto",
      "options": [
        {
          "label": "自动匹配长宽比 (推荐)",
          "value": "auto"
        },
        {
          "label": "横向 (Landscape)",
          "value": "landscape"
        },
        {
          "label": "纵向 (Portrait)",
          "value": "portrait"
        }
      ],
      "visibleIf": {
        "field": "subTool",
        "equals": "cad_to_pdf"
      }
    },
    {
      "id": "pptxToPdfInput",
      "label": "选择待转换 PPT 演示文稿 (.pptx)",
      "type": "file_picker",
      "required": true,
      "allowMultiple": false,
      "allowedExtensions": [
        "pptx"
      ],
      "visibleIf": {
        "field": "subTool",
        "in": [
          "pptx_to_pdf",
          "pptx_to_pdf_android"
        ]
      },
      "banners": [
        {
          "platform": "windows",
          "type": "info",
          "icon": "desktop_windows",
          "message": "💡 Windows 提示：本功能需电脑安装 Microsoft Office（PowerPoint、Word、Excel）或 WPS 工具。转换时将调用电脑本地原生办公套件进行 100% 格式无损导出为 PDF。"
        },
        {
          "platform": "android",
          "type": "success",
          "icon": "phone_android",
          "message": "💡 Android 官方高保真导出指引：将为您一键调用手机已安装的【WPS Office】或【Microsoft Office】导出。执行前将显示操作步骤与 WPS 会员权限说明。"
        }
      ]
    },
    {
      "id": "pdfToPptxInput",
      "label": "选择待转换 PDF 文档 (.pdf)",
      "type": "file_picker",
      "required": true,
      "allowMultiple": false,
      "allowedExtensions": [
        "pdf"
      ],
      "visibleIf": {
        "field": "subTool",
        "equals": "pdf_to_pptx"
      }
    },
    {
      "id": "pdfAspect",
      "label": "幻灯片画面比例与方向",
      "type": "select",
      "defaultValue": "auto",
      "options": [
        {
          "label": "自适应匹配 (推荐)",
          "value": "auto"
        },
        {
          "label": "16:9 宽屏 (横向)",
          "value": "16:9"
        },
        {
          "label": "4:3 标屏 (横向)",
          "value": "4:3"
        },
        {
          "label": "3:4 竖屏 (手机/A4)",
          "value": "portrait"
        }
      ],
      "visibleIf": {
        "field": "subTool",
        "equals": "pdf_to_pptx"
      }
    },
    {
      "id": "pdfDpi",
      "label": "幻灯片光栅化渲染分辨率",
      "type": "select",
      "defaultValue": "150",
      "options": [
        {
          "label": "150 DPI 高清 (推荐)",
          "value": "150"
        },
        {
          "label": "300 DPI 超清 (高精印刷)",
          "value": "300"
        }
      ],
      "visibleIf": {
        "field": "subTool",
        "equals": "pdf_to_pptx"
      }
    },
    {
      "id": "excelInput",
      "label": "选择 Excel 工作簿或表格数据 (.xlsx, .csv, .tsv)",
      "type": "file_picker",
      "required": true,
      "allowMultiple": false,
      "allowedExtensions": [
        "xlsx",
        "csv",
        "tsv"
      ],
      "visibleIf": {
        "field": "subTool",
        "in": [
          "excel_to_pdf",
          "excel_to_pdf_android",
          "excel_to_pdf_android_office",
          "excel_to_pdf_android_light"
        ]
      },
      "banners": [
        {
          "platform": "windows",
          "type": "info",
          "icon": "desktop_windows",
          "message": "💡 Windows 提示：本功能需电脑安装 Microsoft Office（PowerPoint、Word、Excel）或 WPS 工具。转换时将调用电脑本地原生办公套件进行 100% 格式无损导出为 PDF。"
        },
        {
          "platform": "android",
          "type": "success",
          "icon": "phone_android",
          "visibleIf": {
            "field": "subTool",
            "equals": "excel_to_pdf_android_office"
          },
          "message": "💡 Android 官方高保真导出指引：将为您一键调用手机已安装的【WPS Office】或【Microsoft Office】导出。执行前将显示操作步骤与 WPS 会员权限说明。"
        },
        {
          "platform": "android",
          "type": "info",
          "icon": "table_chart_outlined",
          "visibleIf": {
            "field": "subTool",
            "in": [
              "excel_to_pdf_android_light",
              "excel_to_pdf_android"
            ]
          },
          "message": "💡 纯本地轻量离线生成：无需依赖第三方办公软件，直接在本地解析 Excel 工作表数据，自动计算列宽并生成标准 A4 表格 PDF。"
        }
      ]
    },
    {
      "id": "mdInput",
      "label": "选择 Markdown 文本文档 (.md, .markdown)",
      "type": "file_picker",
      "required": true,
      "allowMultiple": false,
      "allowedExtensions": [
        "md",
        "markdown",
        "txt"
      ],
      "visibleIf": {
        "field": "subTool",
        "equals": "markdown_to_pdf"
      }
    },
    {
      "id": "txtInput",
      "label": "选择 TXT 纯文本文件 (.txt, .log, .ini)",
      "type": "file_picker",
      "required": true,
      "allowMultiple": false,
      "allowedExtensions": [
        "txt",
        "log",
        "ini"
      ],
      "visibleIf": {
        "field": "subTool",
        "equals": "txt_to_docx"
      }
    },
    {
      "id": "txtTemplate",
      "label": "Word 智能排版模板",
      "type": "select",
      "defaultValue": "standard",
      "options": [
        {
          "label": "🏛️ 标准公文规范 (仿宋+黑体 · 2字符首行缩进 · 1.25倍行距)",
          "value": "standard"
        },
        {
          "label": "🎓 高校学术论文 (宋体+Times · 1.5倍行距 · 规范大纲)",
          "value": "academic"
        },
        {
          "label": "📖 随笔小说阅读 (五号楷体 · 紧凑段落 · 舒适行距)",
          "value": "reading"
        },
        {
          "label": "💻 技术源码日志 (等宽Consolas · 紧凑代码无缩进)",
          "value": "code_log"
        }
      ],
      "visibleIf": {
        "field": "subTool",
        "equals": "txt_to_docx"
      }
    },
    {
      "id": "docxInput",
      "label": "选择 Microsoft Word 文档 (.docx)",
      "type": "file_picker",
      "required": true,
      "allowMultiple": false,
      "allowedExtensions": [
        "docx"
      ],
      "visibleIf": {
        "field": "subTool",
        "in": [
          "docx_to_pdf",
          "docx_to_pdf_android"
        ]
      },
      "banners": [
        {
          "platform": "windows",
          "type": "info",
          "icon": "desktop_windows",
          "message": "💡 Windows 提示：本功能需电脑安装 Microsoft Office（PowerPoint、Word、Excel）或 WPS 工具。转换时将调用电脑本地原生办公套件进行 100% 格式无损导出为 PDF。"
        },
        {
          "platform": "android",
          "type": "success",
          "icon": "phone_android",
          "message": "💡 Android 官方高保真导出指引：将为您一键调用手机已安装的【WPS Office】或【Microsoft Office】导出。执行前将显示操作步骤与 WPS 会员权限说明。"
        }
      ]
    },
    {
      "id": "pdfToDocxInput",
      "label": "选择待转换 PDF 文档 (.pdf)",
      "type": "file_picker",
      "required": true,
      "allowMultiple": false,
      "allowedExtensions": [
        "pdf"
      ],
      "visibleIf": {
        "field": "subTool",
        "in": [
          "pdf_to_docx",
          "pdf_to_docx_android_office",
          "pdf_to_docx_android_light"
        ]
      },
      "banners": [
        {
          "platform": "android",
          "type": "success",
          "icon": "phone_android",
          "visibleIf": {
            "field": "subTool",
            "equals": "pdf_to_docx_android_office"
          },
          "message": "💡 Android 官方高保真导出指引：将为您一键调用手机已安装的【WPS Office】或【Microsoft Office】导出。执行前将显示操作步骤与 WPS 会员权限说明。"
        },
        {
          "platform": "android",
          "type": "info",
          "icon": "auto_fix_high",
          "visibleIf": {
            "field": "subTool",
            "equals": "pdf_to_docx_android_light"
          },
          "message": "💡 本地离线智能排版引擎：无需第三方办公软件或 VIP 会员，直接在本地解析 PDF 文本，消除乱空格、修复折行断句，按中文排版规范生成含两字符首行缩进与 A4 版式的可编辑 Word 文档。"
        }
      ]
    },
    {
      "id": "preservePageBreaks",
      "label": "严格保留 PDF 原文跨页分页符",
      "type": "switch",
      "defaultValue": true,
      "visibleIf": {
        "field": "subTool",
        "in": [
          "pdf_to_docx",
          "pdf_to_docx_android_light"
        ]
      }
    }
  ],
  "action": {
    "handler": "doc_converter",
    "params": {
      "subTool": "${subTool}",
      "aspect": "${aspect}",
      "format": "${imgFormat}",
      "exportMode": "${exportMode}",
      "resolution": "${pptResolution}",
      "bundleZip": "${bundleZip}",
      "pageSize": "${cadPageSize}",
      "orientation": "${cadOrientation}",
      "dpi": "${pdfDpi}",
      "txtTemplate": "${txtTemplate}",
      "preservePageBreaks": "${preservePageBreaks}"
    }
  },
  "banners": [
    {
      "platform": "windows",
      "type": "info",
      "icon": "desktop_windows",
      "message": "🪟 Windows 运行环境：PPT/Word/Excel 转 PDF 需电脑安装 Microsoft Office（PowerPoint、Word、Excel）或 WPS Office，转换可达 100% 格式无损。"
    },
    {
      "platform": "android",
      "type": "success",
      "icon": "phone_android",
      "message": "🤖 Android 运行环境：Excel 支持【原生 WPS/Office 导出】与【本地离线轻量转换】；PPT 与 Word 调起手机 WPS 或 Office 导出，跳转前将显示详细操作指引。"
    }
  ]
}