{
  "id": "windows-media-downloader",
  "name": "Windows 流式抓取与下载器",
  "version": "1.0.0",
  "minAppVersion": "1.0.0",
  "category": "win_ext",
  "platforms": [
    "windows"
  ],
  "executionType": "native_executable",
  "description": "【Windows 开放工坊精选】基于 Windows 原生流式管道与命令行下载器，支持大文件切片拉取、断点续传、实时 Obsidian 极客黑框日志监视与任务一键强杀。",
  "icon": "bolt",
  "author": "Toolbox 开放工坊",
  "engineType": "win_native_runner",
  "inputs": [
    {
      "id": "url",
      "label": "资源下载直链 / 流媒体地址 (HTTP/HTTPS)",
      "type": "text",
      "defaultValue": "https://speed.cloudflare.com/__down?bytes=10485760",
      "required": true
    },
    {
      "id": "fileName",
      "label": "本地落盘文件名 (含扩展名)",
      "type": "text",
      "defaultValue": "stream_download.dat",
      "required": true
    }
  ],
  "nativeRunner": {
    "entry": "curl.exe",
    "args": [
      "-L",
      "-o",
      "{outputDir}/{fileName}",
      "{url}"
    ],
    "showTerminal": true
  }
}
