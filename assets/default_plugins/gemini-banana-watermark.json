{
  "id": "gemini-banana-watermark",
  "name": "Gemini 去水印",
  "version": "1.0.0",
  "minAppVersion": "1.0.0",
  "category": "image",
  "description": "基于工业级逆向 Alpha 混合数学解算算法（Reverse Alpha Blending），完美无损擦除 Google Gemini、Nano Banana、Imagen 3 等 AI 生图右下角半透明四角星光水印。通过数学逆解逐像素精准恢复被遮挡的原始底色，拒绝任何破坏画质的模糊涂抹与 AI 虚构填补。全平台通用、零云端依赖、离线秒级批量完成。",
  "icon": {
    "type": "code",
    "data": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"5\" fill=\"currentColor\" fill-opacity=\"0.22\"/><path d=\"M12 6.5l1.3 3.7 3.7 1.3-3.7 1.3L12 16.5l-1.3-3.7L7 11.5l3.7-1.3z\" fill=\"currentColor\"/><circle cx=\"17\" cy=\"7.5\" r=\"1.3\" fill=\"currentColor\"/><circle cx=\"7\" cy=\"16.5\" r=\"1.3\" fill=\"currentColor\"/></svg>"
  },
  "author": "SuJiu & Community",
  "engineType": "native_image",
  "platforms": [
    "universal"
  ],
  "inputs": [
    {
      "id": "sourceFiles",
      "label": "选择 Gemini / Nano Banana 原始图片 (支持批量)",
      "type": "file_picker",
      "required": true,
      "allowMultiple": true,
      "allowedExtensions": [
        "png",
        "webp",
        "jpg",
        "jpeg"
      ]
    },
    {
      "id": "detectMode",
      "label": "水印匹配模式",
      "type": "select",
      "defaultValue": "auto",
      "options": [
        {
          "label": "🤖 智能自适应 (多尺度皮尔逊相关度自动测定 1K/2K/4K 推荐)",
          "value": "auto"
        },
        {
          "label": "🌟 Gemini 2K / 4K 超清规格 (96×96 水印，边距 192px)",
          "value": "gemini_2k"
        },
        {
          "label": "🖼️ Gemini 1K 标准规格 (96×96 水印，边距 64px)",
          "value": "force_96"
        },
        {
          "label": "📐 Gemini 0.5K / 小图规格 (48×48 水印，边距 32px)",
          "value": "force_48"
        },
        {
          "label": "🛠️ 高级自定义微调模式 (手动指定尺寸与边距)",
          "value": "custom"
        }
      ]
    },
    {
      "id": "customLogoSize",
      "label": "水印尺寸 (px)",
      "type": "select",
      "defaultValue": "96",
      "options": [
        {
          "label": "96 × 96 像素 (标准大图)",
          "value": "96"
        },
        {
          "label": "48 × 48 像素 (标准小图)",
          "value": "48"
        }
      ],
      "visibleIf": {
        "field": "detectMode",
        "equals": "custom"
      }
    },
    {
      "id": "customMarginRight",
      "label": "右侧边距 (px)",
      "type": "number",
      "defaultValue": 64,
      "visibleIf": {
        "field": "detectMode",
        "equals": "custom"
      }
    },
    {
      "id": "customMarginBottom",
      "label": "底部边距 (px)",
      "type": "number",
      "defaultValue": 64,
      "visibleIf": {
        "field": "detectMode",
        "equals": "custom"
      }
    },
    {
      "id": "format",
      "label": "目标导出格式",
      "type": "select",
      "defaultValue": "keep_original",
      "options": [
        {
          "label": "保持原图格式 (推荐，最保真)",
          "value": "keep_original"
        },
        {
          "label": "导出为 PNG (最高无损保真)",
          "value": "png"
        },
        {
          "label": "导出为 WebP (轻巧高效)",
          "value": "webp"
        },
        {
          "label": "导出为 JPG",
          "value": "jpg"
        }
      ]
    }
  ],
  "action": {
    "handler": "gemini_banana_watermark",
    "params": {
      "detectMode": "${detectMode}",
      "customLogoSize": "${customLogoSize}",
      "customMarginRight": "${customMarginRight}",
      "customMarginBottom": "${customMarginBottom}",
      "format": "${format}"
    }
  }
}